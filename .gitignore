# Gradle local state and build output
.gradle/
**/build/

# IDE metadata
.idea/
*.iml
.classpath
.project
.settings/

# Share only the minimal VS Code project-model settings; keep personal/editor
# workspace state out of Git.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# VS Code Java / Eclipse Buildship compiler output
**/bin/

# Local release staging. Release binaries belong in GitHub Actions artifacts or
# GitHub Releases, never in source control.
release-input/
release-final/
release-artifacts/
*.patch
*.zip
# Private key/secret material. Public trust anchors use .pub/.txt and remain trackable.
*.key
*.pem
*.p8
*.pk8

# OS noise
.DS_Store
Thumbs.db
